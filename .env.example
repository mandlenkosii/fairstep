# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings → API). Added in Phase 3.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
