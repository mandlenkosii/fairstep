# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Connect button → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: Project Settings → API Keys → Secret keys (sb_secret_...).
# Server-only. Bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Connect → Connection String → URI → Session pooler, with your database password.
# Encode special characters in the password (? → %3F, @ → %40, # → %23).
# Only used on your machine to apply migrations and seed data. Not needed on Vercel.
SUPABASE_DB_URL=

# Public URL of the app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
